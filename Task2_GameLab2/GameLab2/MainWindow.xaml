<Window x:Class="GameLab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Enemy name:" FontSize="14" Width="120"/>
                <TextBlock Text="" FontSize="14" Name="EnemyName"/>
            </StackPanel>

            <TextBlock Text="Enemy hit point:" FontSize="14"/>
            <TextBlock Name="EnemyHitPoint" FontSize="18" FontWeight="Bold"/>

            <TextBlock Text="Gold from enemy:" FontSize="14"/>
            <TextBlock Name="GoldFromenemy" FontSize="18" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBlock Text="Click to deal damage:" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Button Click="DealDamage" BorderBrush="Black" BorderThickness="1" Width="140" Height="140" Background="#F5F5F5">
                <Image Name="EnemyImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Margin="10"/>
            </Button>

            <UniformGrid Columns="2" Margin="0,10,0,0" Width="140">
                <Button Click="RepeatEnemy" Content="Repeat" Height="30"/>
                <Button Click="NextEnemy" Content="Next" Height="30"/>
            </UniformGrid>
            <Border Height="300" Width="300">
                <Canvas x:Name="GameCanvas" Background="#F9F9F9" MouseDown="GameCanvas_MouseDown" ClipToBounds="True"/>
            </Border>
        </StackPanel>

        <Grid Grid.Column="2" Margin="30,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="Players gold:" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock Name="PlayerGold" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Players damage:" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock Name="PlayerDamage" FontSize="18" FontWeight="Bold"/>


                <TextBlock Text="Players cd:" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock Name="PlayerCD" FontSize="18" FontWeight="Bold"/>
            </StackPanel>



            <StackPanel Orientation="Vertical" Grid.Column="1">
                
                <TextBlock Text="Level:" FontSize="14" Width="120"/>
                <TextBlock Name="PlayerLevel" FontSize="14"/>
                <Button Click="UpgradeClick" Content="Upgrade" Width="100" Height="40"/>
                <TextBlock Name="UpgradeCost" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
